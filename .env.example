# Copiar a .env y ajustar. No commitear .env real.
# Estos valores son solo defaults de desarrollo para precargar la pantalla
# de configuración (broker/nodeId/unitId/role se guardan localmente en la
# app, no dependen de este archivo en producción).

EXPO_PUBLIC_DEFAULT_MQTT_URL=ws://192.168.1.100:9001
EXPO_PUBLIC_DEFAULT_BACKEND_URL=http://192.168.1.100:3000
